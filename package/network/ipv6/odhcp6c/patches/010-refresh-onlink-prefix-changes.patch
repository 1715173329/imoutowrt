+			odhcp6c_expire(false);
+			dhcpv6_calc_refresh_timers();
 			retx->timeout = t1;
-		else if (req_msg_type == DHCPV6_MSG_RENEW)
+		} else if (req_msg_type == DHCPV6_MSG_RENEW)
